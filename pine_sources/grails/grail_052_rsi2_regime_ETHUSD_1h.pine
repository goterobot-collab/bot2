//@version=5
// AUTO-GENERATED FROM GRAIL LOOP  (tools/emit_pine.py)
// Strategy family: rsi2_regime
// Asset: ETHUSD   TF: 1h
// In-sample metrics:  WR 66.38%  PF 1.382  ret 26.34%  DD -6.99%  trades 116
// Params: {"rsi_len": 4, "rsi_buy": 15, "sma_trend": 75, "slope_bars": 40, "exit_sma": 8}
// Exit:   {"sl_atr": 1.0, "tp_atr": 5.0, "trail_atr": 2.5}
strategy("GRAIL #052 rsi2_regime ETHUSD 1h",
     overlay=true,
     initial_capital=10000,
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=100,
     commission_type=strategy.commission.percent,
     commission_value=0.1,
     slippage=2,
     process_orders_on_close=false)

useWindow = input.bool(true, "Apply in-sample window")
startTs = timestamp(2018, 08, 02, 0, 0)
inWindow = not useWindow or time >= startTs


rsiLen   = 4
rsiBuy   = 15
smaTrend = 75
slopeBars = 40
exitSma   = 8

slow = ta.sma(close, smaTrend)
fast = ta.sma(close, exitSma)
r    = ta.rsi(close, rsiLen)
rising = slow > slow[slopeBars]

longCond = inWindow and rising and close > slow and r < rsiBuy
exitCond = close > fast

atrV = ta.atr(14)
if longCond and strategy.position_size == 0
    strategy.entry("long", strategy.long)
    strategy.exit("sltp", "long", stop=strategy.position_avg_price - 1.0*atrV, limit=strategy.position_avg_price + 5.0*atrV)
    strategy.exit("trail", "long", trail_price=high - 2.5*atrV, trail_offset=0)

if strategy.position_size > 0 and exitCond
    strategy.close("long")

plot(slow, color=color.orange)
plot(fast, color=color.blue)
