//@version=5
// AUTO-GENERATED FROM GRAIL LOOP  (tools/emit_pine.py)
// Strategy family: bb_trend_rejoin
// Asset: DOGEUSD   TF: 1h
// In-sample metrics:  WR 83.33%  PF 14.652  ret 46.45%  DD -2.95%  trades 6
// Params: {"bb_len": 100, "bb_mult": 1.5, "trend": 175}
// Exit:   {"sl_atr": 1.25, "tp_atr": 3.0, "trail_atr": 3.5, "timeout": 168}
strategy("GRAIL #011 bb_trend_rejoin DOGEUSD 1h",
     overlay=true,
     initial_capital=10000,
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=100,
     commission_type=strategy.commission.percent,
     commission_value=0.1,
     slippage=2,
     process_orders_on_close=false)

useWindow = input.bool(true, "Apply in-sample window")
startTs = timestamp(2021, 09, 29, 0, 0)
inWindow = not useWindow or time >= startTs


bbLen = 100
bbMult = 1.5
trendLen = 175

basis = ta.sma(close, bbLen)
dev = bbMult * ta.stdev(close, bbLen)
lower = basis - dev
upper = basis + dev
t = ta.ema(close, trendLen)

longCond = inWindow and ta.crossover(close, lower) and close > t
exitCond = ta.crossover(close, basis)

atrV = ta.atr(14)
var int entryBar = na
if longCond and strategy.position_size == 0
    strategy.entry("long", strategy.long)
    entryBar := bar_index
    strategy.exit("sltp", "long", stop=strategy.position_avg_price - 1.25*atrV, limit=strategy.position_avg_price + 3.0*atrV)
    strategy.exit("trail", "long", trail_price=high - 3.5*atrV, trail_offset=0)
if strategy.position_size > 0 and not na(entryBar) and bar_index - entryBar >= 168
    strategy.close("long")
    entryBar := na

if strategy.position_size > 0 and exitCond
    strategy.close("long")

plot(basis, color=color.orange)
plot(lower, color=color.green)
plot(upper, color=color.red)
plot(t,     color=color.gray, title="Trend EMA")
