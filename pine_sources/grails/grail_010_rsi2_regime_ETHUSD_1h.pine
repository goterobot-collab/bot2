//@version=5
// AUTO-GENERATED FROM GRAIL LOOP  (tools/emit_pine.py)
// Strategy family: rsi2_regime
// Asset: ETHUSD   TF: 1h
// In-sample metrics:  WR 75.51%  PF 2.799  ret 69.73%  DD -9.78%  trades 49
// Params: {"rsi_len": 5, "rsi_buy": 15, "sma_trend": 100, "slope_bars": 50, "exit_sma": 21}
// Exit:   {"sl_atr": 5.0, "tp_atr": 10.0, "timeout": 72}
strategy("GRAIL #010 rsi2_regime ETHUSD 1h",
     overlay=true,
     initial_capital=10000,
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=100,
     commission_type=strategy.commission.percent,
     commission_value=0.1,
     slippage=2,
     process_orders_on_close=false)

useWindow = input.bool(true, "Apply in-sample window")
startTs = timestamp(2018, 08, 02, 0, 0)
inWindow = not useWindow or time >= startTs


rsiLen   = 5
rsiBuy   = 15
smaTrend = 100
slopeBars = 50
exitSma   = 21

slow = ta.sma(close, smaTrend)
fast = ta.sma(close, exitSma)
r    = ta.rsi(close, rsiLen)
rising = slow > slow[slopeBars]

longCond = inWindow and rising and close > slow and r < rsiBuy
exitCond = close > fast

atrV = ta.atr(14)
var int entryBar = na
if longCond and strategy.position_size == 0
    strategy.entry("long", strategy.long)
    entryBar := bar_index
    strategy.exit("sltp", "long", stop=strategy.position_avg_price - 5.0*atrV, limit=strategy.position_avg_price + 10.0*atrV)
if strategy.position_size > 0 and not na(entryBar) and bar_index - entryBar >= 72
    strategy.close("long")
    entryBar := na

if strategy.position_size > 0 and exitCond
    strategy.close("long")

plot(slow, color=color.orange)
plot(fast, color=color.blue)
