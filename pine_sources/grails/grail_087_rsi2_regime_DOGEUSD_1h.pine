//@version=5
// AUTO-GENERATED FROM GRAIL LOOP  (tools/emit_pine.py)
// Strategy family: rsi2_regime
// Asset: DOGEUSD   TF: 1h
// In-sample metrics:  WR 74.07%  PF 2.286  ret 21.75%  DD -6.16%  trades 27
// Params: {"rsi_len": 3, "rsi_buy": 8, "sma_trend": 75, "slope_bars": 30, "exit_sma": 21}
// Exit:   {"sl_atr": 5.0, "trail_atr": 3.5, "timeout": 36}
strategy("GRAIL #087 rsi2_regime DOGEUSD 1h",
     overlay=true,
     initial_capital=10000,
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=100,
     commission_type=strategy.commission.percent,
     commission_value=0.1,
     slippage=2,
     process_orders_on_close=false)

useWindow = input.bool(true, "Apply in-sample window")
startTs = timestamp(2021, 09, 29, 0, 0)
inWindow = not useWindow or time >= startTs


rsiLen   = 3
rsiBuy   = 8
smaTrend = 75
slopeBars = 30
exitSma   = 21

slow = ta.sma(close, smaTrend)
fast = ta.sma(close, exitSma)
r    = ta.rsi(close, rsiLen)
rising = slow > slow[slopeBars]

longCond = inWindow and rising and close > slow and r < rsiBuy
exitCond = close > fast

atrV = ta.atr(14)
var int entryBar = na
if longCond and strategy.position_size == 0
    strategy.entry("long", strategy.long)
    entryBar := bar_index
    strategy.exit("sltp", "long", stop=strategy.position_avg_price - 5.0*atrV, limit=na)
    strategy.exit("trail", "long", trail_price=high - 3.5*atrV, trail_offset=0)
if strategy.position_size > 0 and not na(entryBar) and bar_index - entryBar >= 36
    strategy.close("long")
    entryBar := na

if strategy.position_size > 0 and exitCond
    strategy.close("long")

plot(slow, color=color.orange)
plot(fast, color=color.blue)
