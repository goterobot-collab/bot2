//@version=5
// AUTO-GENERATED FROM GRAIL LOOP  (tools/emit_pine.py)
// Strategy family: zscore_revert
// Asset: ETHUSD   TF: 1h
// In-sample metrics:  WR 68.18%  PF 1.513  ret 49.19%  DD -22.34%  trades 66
// Params: {"z_len": 80, "z_enter": 2.0, "trend": 300}
// Exit:   {"sl_atr": 3.0}
strategy("GRAIL #037 zscore_revert ETHUSD 1h",
     overlay=true,
     initial_capital=10000,
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=100,
     commission_type=strategy.commission.percent,
     commission_value=0.1,
     slippage=2,
     process_orders_on_close=false)

useWindow = input.bool(true, "Apply in-sample window")
startTs = timestamp(2018, 08, 02, 0, 0)
inWindow = not useWindow or time >= startTs


zLen    = 80
zEnter  = 2.0
trendLen = 300

m  = ta.sma(close, zLen)
sd = ta.stdev(close, zLen)
z  = (close - m) / math.max(sd, 0.0000001)
t  = ta.ema(close, trendLen)

longCond = inWindow and ta.crossover(z, -zEnter) and close > t
exitCond = ta.crossover(z, 0.0)

atrV = ta.atr(14)
if longCond and strategy.position_size == 0
    strategy.entry("long", strategy.long)
    strategy.exit("sltp", "long", stop=strategy.position_avg_price - 3.0*atrV, limit=na)

if strategy.position_size > 0 and exitCond
    strategy.close("long")

plot(t, color=color.orange, title="Trend EMA")
