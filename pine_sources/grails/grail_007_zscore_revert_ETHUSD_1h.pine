//@version=5
// AUTO-GENERATED FROM GRAIL LOOP  (tools/emit_pine.py)
// Strategy family: zscore_revert
// Asset: ETHUSD   TF: 1h
// In-sample metrics:  WR 62.77%  PF 1.484  ret 56.84%  DD -11.09%  trades 137
// Params: {"z_len": 30, "z_enter": 2.0, "trend": 100}
// Exit:   {"sl_atr": 1.5, "tp_atr": 3.0, "trail_atr": 4.0, "timeout": 24}
strategy("GRAIL #007 zscore_revert ETHUSD 1h",
     overlay=true,
     initial_capital=10000,
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=100,
     commission_type=strategy.commission.percent,
     commission_value=0.1,
     slippage=2,
     process_orders_on_close=false)

useWindow = input.bool(true, "Apply in-sample window")
startTs = timestamp(2018, 08, 02, 0, 0)
inWindow = not useWindow or time >= startTs


zLen    = 30
zEnter  = 2.0
trendLen = 100

m  = ta.sma(close, zLen)
sd = ta.stdev(close, zLen)
z  = (close - m) / math.max(sd, 0.0000001)
t  = ta.ema(close, trendLen)

longCond = inWindow and ta.crossover(z, -zEnter) and close > t
exitCond = ta.crossover(z, 0.0)

atrV = ta.atr(14)
var int entryBar = na
if longCond and strategy.position_size == 0
    strategy.entry("long", strategy.long)
    entryBar := bar_index
    strategy.exit("sltp", "long", stop=strategy.position_avg_price - 1.5*atrV, limit=strategy.position_avg_price + 3.0*atrV)
    strategy.exit("trail", "long", trail_price=high - 4.0*atrV, trail_offset=0)
if strategy.position_size > 0 and not na(entryBar) and bar_index - entryBar >= 24
    strategy.close("long")
    entryBar := na

if strategy.position_size > 0 and exitCond
    strategy.close("long")

plot(t, color=color.orange, title="Trend EMA")
