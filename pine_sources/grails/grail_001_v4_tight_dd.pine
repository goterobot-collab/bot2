//@version=5
// GRAIL #1 v4 — long-only, DD agresivamente limitado
// Basado en plateau #1 (rsi2_regime ETHUSD 1h, 22/22 vecinos OK).
// Objetivo: DD < 12%, aunque sacrifique PnL total.
strategy("GRAIL #1 v4 rsi2_regime ETHUSD 1h (tight DD)",
     overlay=true,
     initial_capital=10000,
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=100,
     commission_type=strategy.commission.percent,
     commission_value=0.05,
     slippage=2,
     process_orders_on_close=false)

// === RIESGO — más conservador que v2 =====================================
riskPct    = input.float(0.5, "Riesgo por trade (%)", minval=0.1, maxval=3.0, step=0.1)
maxLossStk = input.int(2,  "Pausa tras N pérdidas seguidas")
pauseBars  = input.int(48, "Barras de pausa tras racha")
maxDDHalt  = input.float(12.0, "Halt definitivo si DD >")

// === FILTRO MACRO — más exigente =========================================
useDailyFilter = input.bool(true, "Daily EMA200 filter")
useSlope       = input.bool(true, "Exigir EMA200 daily subiendo")
dailyEmaLen    = input.int(200, "Daily EMA length")
slopeDays      = input.int(7,   "Slope lookback en días")

dailyEma    = request.security(syminfo.tickerid, "D", ta.ema(close, dailyEmaLen), lookahead=barmerge.lookahead_off)
dailyClose  = request.security(syminfo.tickerid, "D", close[1], lookahead=barmerge.lookahead_off)
dailyEmaPrev = request.security(syminfo.tickerid, "D", ta.ema(close, dailyEmaLen)[slopeDays], lookahead=barmerge.lookahead_off)
macroBull = (not useDailyFilter or dailyClose > dailyEma) and (not useSlope or dailyEma > dailyEmaPrev)

// === SEÑAL (plateau #1) ==================================================
rsiLen    = input.int(2, "RSI length")
rsiBuy    = input.int(3, "RSI buy threshold")
smaTrend  = input.int(100, "Trend SMA length")
slopeBars = input.int(5, "Slope lookback")
exitSma   = input.int(8, "Exit SMA length")

// === EXIT — SL ajustado ==================================================
slAtr     = input.float(2.0, "SL × ATR")
tpAtr     = input.float(3.0, "TP × ATR")
trailAtr  = input.float(2.5, "Trail × ATR")
maxBars   = input.int(72, "Timeout (barras)")

// === INDICADORES =========================================================
slow = ta.sma(close, smaTrend)
fast = ta.sma(close, exitSma)
r    = ta.rsi(close, rsiLen)
rising = slow > slow[slopeBars]
atrV = ta.atr(14)

longSignal = rising and close > slow and r < rsiBuy and macroBull
exitSignal = close > fast

// === CIRCUIT BREAKER =====================================================
var int lossStreak = 0
var int pauseUntilBar = 0
if strategy.closedtrades > strategy.closedtrades[1]
    lastPnL = strategy.closedtrades.profit(strategy.closedtrades - 1)
    if lastPnL < 0
        lossStreak := lossStreak + 1
    else
        lossStreak := 0
    if lossStreak >= maxLossStk
        pauseUntilBar := bar_index + pauseBars
        lossStreak := 0
paused = bar_index < pauseUntilBar
equityPeak = ta.max(strategy.equity)
curDD = (equityPeak - strategy.equity) / equityPeak * 100
halted = curDD > maxDDHalt

// === SIZING POR RIESGO ===================================================
riskUsd  = strategy.equity * riskPct / 100.0
stopDist = slAtr * atrV
qty      = stopDist > 0 ? riskUsd / stopDist : 0
canTrade = not paused and not halted and qty > 0

// === ENTRADA / SALIDA ====================================================
var int entryBar = 0
if longSignal and strategy.position_size == 0 and canTrade
    strategy.entry("long", strategy.long, qty=qty)
    entryBar := bar_index
    strategy.exit("brkt", "long",
         stop  = strategy.position_avg_price - slAtr * atrV,
         limit = strategy.position_avg_price + tpAtr * atrV,
         trail_points = trailAtr * atrV / syminfo.mintick,
         trail_offset = 0)

if strategy.position_size > 0 and exitSignal
    strategy.close("long", comment="exit SMA")

if strategy.position_size > 0 and (bar_index - entryBar) >= maxBars
    strategy.close("long", comment="timeout")

// === VISUAL ==============================================================
plot(slow, "SMA trend", color=color.orange)
plot(fast, "SMA exit",  color=color.blue)
plot(dailyEma, "Daily EMA200", color=color.new(color.red, 40), linewidth=2)
bgcolor(halted ? color.new(color.red, 80) : na)
bgcolor(paused ? color.new(color.yellow, 90) : na)
bgcolor(not macroBull ? color.new(color.gray, 92) : na)
