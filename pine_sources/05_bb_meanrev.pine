//@version=5
// Bollinger Band mean-reversion: long on cross above lower band, exit on cross above middle.
strategy("BB(20,2) Mean Reversion",
     overlay=true,
     initial_capital=10000,
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=100,
     commission_type=strategy.commission.percent,
     commission_value=0.1,
     slippage=2)

bbLen     = input.int(20,  "BB length")
bbMult    = input.float(2.0, "BB std mult")
bars_back = input.int(365, "Backtest window (days)")

startTs = timestamp(year(timenow) - bars_back/365, month(timenow), dayofmonth(timenow), 0, 0)
inWindow = time >= startTs

basis = ta.sma(close, bbLen)
dev   = bbMult * ta.stdev(close, bbLen)
lower = basis - dev
upper = basis + dev

longCond = inWindow and ta.crossover(close, lower)
exitCond = ta.crossover(close, basis)

if longCond and strategy.position_size == 0
    strategy.entry("long", strategy.long)
if strategy.position_size > 0 and exitCond
    strategy.close("long")

plot(basis, color=color.orange, title="Basis")
plot(lower, color=color.green,  title="Lower")
plot(upper, color=color.red,    title="Upper")
