//@version=5
// EMA 9/21 crossover with EMA200 trend filter. Long-only.
strategy("EMA 9/21 Cross + EMA200",
     overlay=true,
     initial_capital=10000,
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=100,
     commission_type=strategy.commission.percent,
     commission_value=0.1,
     slippage=2)

fastLen   = input.int(9,   "Fast EMA")
slowLen   = input.int(21,  "Slow EMA")
trendLen  = input.int(200, "Trend EMA")
bars_back = input.int(365, "Backtest window (days)")

startTs = timestamp(year(timenow) - bars_back/365, month(timenow), dayofmonth(timenow), 0, 0)
inWindow = time >= startTs

e1 = ta.ema(close, fastLen)
e2 = ta.ema(close, slowLen)
et = ta.ema(close, trendLen)

longCond = inWindow and ta.crossover(e1, e2) and close > et
exitCond = ta.crossunder(e1, e2)

if longCond and strategy.position_size == 0
    strategy.entry("long", strategy.long)
if strategy.position_size > 0 and exitCond
    strategy.close("long")

plot(e1, color=color.blue,   title="EMA9")
plot(e2, color=color.orange, title="EMA21")
plot(et, color=color.gray,   title="EMA200")
