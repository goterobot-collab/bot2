//@version=5
// Linda Raschke "Holy Grail" — ADX(14)>30 + DI+ > DI- + pullback to EMA(20).
// Entry on recovery close above prior bar high. 2×ATR TP, 1×ATR SL.
strategy("Holy Grail (Raschke)",
     overlay=true, initial_capital=10000,
     default_qty_type=strategy.percent_of_equity, default_qty_value=100,
     commission_type=strategy.commission.percent, commission_value=0.1, slippage=2)

adxLen    = input.int(14,  "ADX length")
adxMin    = input.int(30,  "ADX min")
emaLen    = input.int(20,  "EMA pullback")
atrLen    = input.int(14,  "ATR length")
tpMult    = input.float(2.0, "TP × ATR")
slMult    = input.float(1.0, "SL × ATR")
bars_back = input.int(365, "Backtest window (days)")

startTs = timestamp(year(timenow) - bars_back/365, month(timenow), dayofmonth(timenow), 0, 0)
inWindow = time >= startTs

[di_p, di_m, adx] = ta.dmi(adxLen, adxLen)
e20 = ta.ema(close, emaLen)
a   = ta.atr(atrLen)

pulled  = ta.lowest(low, 5) <= e20
trending= adx > adxMin and di_p > di_m
recovery= close > close[1] and close > e20

longCond = inWindow and trending and pulled and recovery

if longCond and strategy.position_size == 0
    strategy.entry("long", strategy.long)
    strategy.exit("x", "long", stop=close - slMult*a, limit=close + tpMult*a)

plot(e20, color=color.orange)
