//@version=5
// Stochastic(14,3,3) oversold cross reversal.
strategy("Stoch(14,3) Oversold Cross",
     overlay=false,
     initial_capital=10000,
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=100,
     commission_type=strategy.commission.percent,
     commission_value=0.1,
     slippage=2)

kLen      = input.int(14,  "%K length")
dLen      = input.int(3,   "%D length")
smoothK   = input.int(3,   "Smooth K")
osLvl     = input.int(20,  "Oversold")
obLvl     = input.int(80,  "Overbought")
bars_back = input.int(365, "Backtest window (days)")

startTs = timestamp(year(timenow) - bars_back/365, month(timenow), dayofmonth(timenow), 0, 0)
inWindow = time >= startTs

k = ta.sma(ta.stoch(close, high, low, kLen), smoothK)
d = ta.sma(k, dLen)

longCond = inWindow and ta.crossover(k, d)  and k < osLvl
exitCond = ta.crossunder(k, d) and k > obLvl

if longCond and strategy.position_size == 0
    strategy.entry("long", strategy.long)
if strategy.position_size > 0 and exitCond
    strategy.close("long")

hline(osLvl, "OS", color=color.green)
hline(obLvl, "OB", color=color.red)
plot(k, color=color.blue,   title="%K")
plot(d, color=color.orange, title="%D")
