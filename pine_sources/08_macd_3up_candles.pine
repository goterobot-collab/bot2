//@version=5
// MACD histogram zero-cross + 3 consecutive green candles.
// Adapted from exlux99 "Very high win rate" Pine v4 (removed forex session gate
// and pip-scale TP/SL — those only made sense on forex minors; the crypto version
// below uses ATR-based SL/TP so the logic is meaningful on ADA/DOGE/INJ/ETH).
strategy("MACD Hist + 3UP candles (ATR exits)",
     overlay=true,
     initial_capital=10000,
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=100,
     commission_type=strategy.commission.percent,
     commission_value=0.1,
     slippage=2)

fast      = input.int(12,  "MACD fast")
slow      = input.int(26,  "MACD slow")
sig       = input.int(9,   "MACD signal")
atrLen    = input.int(14,  "ATR length")
slMult    = input.float(2.0, "SL × ATR")
tpMult    = input.float(3.0, "TP × ATR")
bars_back = input.int(365, "Backtest window (days)")

startTs = timestamp(year(timenow) - bars_back/365, month(timenow), dayofmonth(timenow), 0, 0)
inWindow = time >= startTs

[_m, _s, hist] = ta.macd(close, fast, slow, sig)
atrV = ta.atr(atrLen)

up3      = close > open and close[1] > open[1] and close[2] > open[2]
crossUp  = ta.crossover(hist, 0)
longCond = inWindow and up3 and crossUp

if longCond and strategy.position_size == 0
    strategy.entry("long", strategy.long)
    strategy.exit("x", from_entry="long", stop=close - slMult * atrV, limit=close + tpMult * atrV)
