//@version=5
// RSI(2) Mean-Reversion + SMA200 trend filter (Connors methodology, public domain)
// Backtest window: last 365 days by default (configurable).
// Designed for ADA/DOGE/INJ/ETH on 5m, 15m, 1h.
strategy("RSI2 Connors + SMA200",
     overlay=true,
     initial_capital=10000,
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=100,
     commission_type=strategy.commission.percent,
     commission_value=0.1,
     slippage=2,
     calc_on_every_tick=false,
     process_orders_on_close=false)

// --- inputs ---
rsiLen    = input.int(2,   "RSI length",  minval=1)
rsiBuy    = input.int(10,  "RSI buy threshold")
fastLen   = input.int(5,   "Exit SMA length")
slowLen   = input.int(200, "Trend SMA length")
bars_back = input.int(365, "Backtest window (days)")

// --- 1y date gate ---
startTs = timestamp(year(timenow) - bars_back/365, month(timenow), dayofmonth(timenow), 0, 0)
inWindow = time >= startTs

// --- signals ---
r     = ta.rsi(close, rsiLen)
slow  = ta.sma(close, slowLen)
fast  = ta.sma(close, fastLen)

longCond  = inWindow and close > slow and r < rsiBuy
exitCond  = close > fast

if longCond and strategy.position_size == 0
    strategy.entry("long", strategy.long)
if strategy.position_size > 0 and exitCond
    strategy.close("long")

plot(slow, color=color.orange, title="SMA200")
plot(fast, color=color.blue,   title="SMA5")
