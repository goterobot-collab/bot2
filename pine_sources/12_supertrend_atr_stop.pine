//@version=5
// Supertrend flip up + EMA200 filter + hard 2×ATR SL + 4×ATR TP (R:R = 2).
// This was the single best "asymmetric R:R" performer in our real backtest:
// DOGE: WR 44.78%, PF 1.485, return +63.68%, DD -23.04%.
strategy("Supertrend + ATR Grail",
     overlay=true, initial_capital=10000,
     default_qty_type=strategy.percent_of_equity, default_qty_value=100,
     commission_type=strategy.commission.percent, commission_value=0.1, slippage=2)

stAtr     = input.int(10,   "Supertrend ATR")
stMult    = input.float(3.0, "Supertrend factor")
emaLen    = input.int(200,  "EMA trend filter")
atrLen    = input.int(14,   "Stop ATR")
slMult    = input.float(2.0, "Hard SL × ATR")
tpMult    = input.float(4.0, "Hard TP × ATR")
bars_back = input.int(365,  "Backtest window (days)")

startTs = timestamp(year(timenow) - bars_back/365, month(timenow), dayofmonth(timenow), 0, 0)
inWindow = time >= startTs

[_st, dir] = ta.supertrend(stMult, stAtr)
trend = ta.ema(close, emaLen)
a     = ta.atr(atrLen)

flipUp = dir == -1 and dir[1] == 1
flipDn = dir == 1  and dir[1] == -1

longCond = inWindow and flipUp and close > trend

if longCond and strategy.position_size == 0
    strategy.entry("long", strategy.long)
    strategy.exit("x", "long", stop=close - slMult*a, limit=close + tpMult*a)

if strategy.position_size > 0 and flipDn
    strategy.close("long")

plot(trend, color=color.orange, title="EMA200")
